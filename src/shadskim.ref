; Main SkoolKit HTML config for Shadow Skimmer, from the skill's
; assets/game.ref.template. The catalog pages (graphics, sound, data, notes,
; glossary) come with stage 3: add each ref file to RefFiles, with its
; [Index:...], [Paths], [Links] and [Titles] lines, as it is written.

[Config]
RefFiles=glossary.ref;workspace.ref;tune.ref
GameDir=shadskim

; Parsed first, before every other project ref and the skill's theme.ref.
[Game]
Game=Shadow Skimmer

; skoolkit.css is SkoolKit's structure, theme.css the skill's dark layout, and
; shadskim.css (resources/) this project's identity, loaded last so it wins.
StyleSheet=skoolkit.css;theme.css;shadskim.css

; Hex anchors to match the hex-addressed .ctl (see [Paths] CodeFiles).
AddressAnchor={address#IF({base}==16)(:04x)}

Release=The Edge / Softek, 1987
Copyright=Game &copy; 1987 The Edge / Softek. Disassembly for preservation and study.

; Index headings group pages on the home page. Each name must match a
; [Page:...] or a generated page id.
[Index:Reference:Reference]
Glossary
Workspace
tune-Index

[Paths]
CodeFiles={address:04X}.html
Glossary=reference/glossary.html
Workspace=reference/workspace.html
tune-Index=tune/index.html

[Links]
Glossary=Glossary
Workspace=Workspace
tune-Index=Title tune player

[Titles]
Glossary=Glossary
Workspace=Workspace
tune-Index=Title tune player
