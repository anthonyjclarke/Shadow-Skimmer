; Main SkoolKit HTML config for Shadow Skimmer, from the skill's
; assets/game.ref.template. The catalog pages (graphics, sound, data, notes,
; glossary) come with stage 3: add each ref file to RefFiles, with its
; [Index:...], [Paths], [Links] and [Titles] lines, as it is written.

[Config]
RefFiles=glossary.ref;workspace.ref;graphics.ref;screens.ref;sound.ref;tune.ref
GameDir=shadskim
; #DRAWSCREEN(column,row,inside) draws one screen with the game's own code in
; SkoolKit's simulator: the screen clear, then the screen entry of the play
; routine from the hull map position (and the inside-the-hull flag) up to the
; return from the screen draw. A render then takes the play area with #SCR.
; It needs the ROM in the snapshot (@rom at the outer hull layouts), since the
; hatchway draw reads it.
Expand=#DEF(#DRAWSCREEN(column,row,inside) #SIM($B029,$B003,1,sp=$F7F8)#POKES($BD25,$column)#POKES($BD26,$row)#POKES($BD3E,$inside)#SIM($CF6F,$CEDB))

; Parsed first, before every other project ref and the skill's theme.ref.
[Game]
Game=Shadow Skimmer

; skoolkit.css is SkoolKit's structure, theme.css the skill's dark layout, and
; shadskim.css (resources/) this project's identity, loaded last so it wins.
StyleSheet=skoolkit.css;theme.css;shadskim.css

; Hex anchors to match the hex-addressed .ctl (see [Paths] CodeFiles).
AddressAnchor={address#IF({base}==16)(:04x)}

; Link the operands a reader will chase, LD's pointers among them.
LinkOperands=CALL,DEFW,DJNZ,JP,JR,LD

Release=The Edge / Softek, 1987
Copyright=Game &copy; 1987 The Edge / Softek. Disassembly for preservation and study.

; [Index] lists the groups the home page draws, in this order: SkoolKit's own
; list, then Spec, the behaviour pages the site build writes from spec/*.md.
[Index]
MemoryMaps
Graphics
DataTables
OtherCode
Reference
Spec

; SkoolKit heads the DataTables group "Data tables and buffers", storage words
; for what the reader browses as the game's data and its variables (HEAD-2).
[Index:DataTables:Game data]
GameStatusBuffer

; Index headings group pages on the home page. Each name must match a
; [Page:...] or a generated page id.
[Index:Reference:Reference]
Glossary
Graphics
Screens
Sound
Workspace

[Paths]
CodeFiles={address:04X}.html
Glossary=reference/glossary.html
Graphics=reference/graphics.html
Screens=reference/screens.html
Sound=reference/sound.html
Workspace=reference/workspace.html
tune-Index=tune/index.html
; The tune listing's entry pages sit under an asm/ directory, as the main
; listing's do, so that the theme sets links to them in the code face.
tune-CodePath=tune/asm

[Links]
GameStatusBuffer=Variables
Glossary=Glossary
Graphics=Graphics
Screens=Screens
Sound=Sound
Workspace=Workspace
tune-Index=Title tune player

[Titles]
Asm-g=Variables at {entry[address]}
GameStatusBuffer=Variables
Glossary=Glossary
Graphics=Graphics
Screens=Screens
Sound=Sound
Workspace=Workspace
tune-Index=Title tune player

; The game's variables and the buffers it writes as it runs (the `g` entries),
; under a name of this game's rather than SkoolKit's "Game status buffer".
[PageHeaders]
Asm-g=Variables
GameStatusBuffer=Variables
