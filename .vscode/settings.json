{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "files.associations": {
    "*.ctl": "plaintext",
    "*.skool": "z80-asm",
    "*.asm": "z80-asm",
    "*.ref": "ini",
    "*.z80header": "plaintext"
  },
  "files.exclude": { "**/__pycache__": true },
  "search.exclude": { "external/**": true, "build/**": true, ".venv/**": true }
}
